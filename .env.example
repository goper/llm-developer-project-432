# Пример параметров окружения. Скопируйте в .env и поправьте. Настоящий .env в репозиторий не попадает.

# База (порт совпадает с DB_PORT в compose.yml, по умолчанию 5434)
DATABASE_URL=postgresql://app:app@localhost:5434/cards
DB_POOL_MAX_SIZE=10

# Модель: LM Studio (http://localhost:1234/v1), Ollama (http://localhost:11434/v1) или OpenRouter (https://openrouter.ai/api/v1)
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen2.5-14b-instruct
LLM_CHEAP_MODEL=qwen2.5-7b-instruct
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
# schema — передавать схему в запрос; prompt — только текстом в инструкции (для серверов без строгого режима)
LLM_STRUCTURED_MODE=prompt

# Цены, USD за миллион токенов (настройте под выбранную модель)
PRICE_MAIN_INPUT_PER_MTOK=0.50
PRICE_MAIN_OUTPUT_PER_MTOK=1.50
PRICE_CHEAP_INPUT_PER_MTOK=0.05
PRICE_CHEAP_OUTPUT_PER_MTOK=0.15

# Эмбеддинги (локально, sentence-transformers). EMBEDDING_DIM должен совпадать с миграцией 0004 (384).
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
RELEVANCE_THRESHOLD=0.82

# Temporal (порт совпадает с TEMPORAL_PORT в compose.yml, по умолчанию 7234)
TEMPORAL_ADDRESS=localhost:7234
TEMPORAL_TASK_QUEUE=cards

CONFIDENCE_THRESHOLD=0.7
LOG_LEVEL=INFO
